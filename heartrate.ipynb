        "import numpy as np\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.signal import butter, filtfilt\n",
        "\n",
        "VIDEO = \"/content/video.mov\"\n",
        "TRUE_HR = 58\n",
        "\n",
        "# ---------- 1. Open the video ----------\n",
        "cap = cv2.VideoCapture(VIDEO)\n",
        "if not cap.isOpened():\n",
        "    raise SystemExit(\"Could not open video - check the path\")\n",
        "fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "\n",
        "# ---------- 2. Skin region (ROI) - left cheek ----------\n",
        "x1, x2, y1, y2 = 575, 775, 585, 685\n",
        "ok, first = cap.read()\n",
        "check = first.copy()\n",
        "cv2.rectangle(check, (x1, y1), (x2, y2), (0, 255, 0), 3)\n",
        "plt.figure(figsize=(6, 8))\n",
        "plt.imshow(cv2.cvtColor(check, cv2.COLOR_BGR2RGB))\n",
        "plt.title(\"Is the green box on skin only?\"); plt.show()\n",
        "cap.set(cv2.CAP_PROP_POS_FRAMES, 0)\n",
        "\n",
        "# ---------- 3. Average ROI color per frame ----------\n",
        "rgb = []\n",
        "while True:\n",
        "    ok, frame = cap.read()\n",
        "    if not ok:\n",
        "        break\n",
        "    roi = frame[y1:y2, x1:x2]\n",
        "    rgb.append(roi.mean(axis=(0, 1))[::-1])     # BGR -> RGB\n",
        "cap.release()\n",
        "rgb = np.array(rgb)\n",
        "N = len(rgb)\n",
        "print(f\"fps={fps:.2f}, frames={N}, length={N/fps:.1f}s\")\n",
        "\n",
        "# ---------- 4. POS algorithm ----------\n",
        "l = int(1.6 * fps)\n",
        "P = np.array([[0, 1, -1],\n",
        "              [-2, 1, 1]])\n",
        "H = np.zeros(N)\n",
        "for t in range(N - l + 1):\n",
        "    C = rgb[t:t + l]\n",
        "    Cn = C / C.mean(axis=0)\n",
        "    S = P @ Cn.T\n",
        "    alpha = S[0].std() / (S[1].std() + 1e-9)\n",
        "    h = S[0] + alpha * S[1]\n",
        "    H[t:t + l] += h - h.mean()\n",
        "\n",
        "# ---------- 5. Bandpass 0.7-4 Hz (42-240 BPM) ----------\n",
        "b, a = butter(3, [0.7, 4.0], btype=\"band\", fs=fps)\n",
        "Hf = filtfilt(b, a, H)\n",
        "\n",
        "# ---------- 6. FFT -> heart rate ----------\n",
        "freqs = np.fft.rfftfreq(N, d=1 / fps)\n",
        "mag = np.abs(np.fft.rfft(Hf))\n",
        "band = (freqs >= 0.7) & (freqs <= 4.0)\n",
        "bpm = freqs[band][np.argmax(mag[band])] * 60\n",
        "print(f\"Estimated HR: {bpm:.1f} BPM | True: {TRUE_HR} | Error: {abs(bpm - TRUE_HR):.1f} BPM\")\n",
        "\n",
        "# ---------- 7. Plots ----------\n",
        "t = np.arange(N) / fps\n",
        "fig, ax = plt.subplots(3, 1, figsize=(10, 8))\n",
        "ax[0].plot(t, rgb[:, 1] - rgb[:, 1].mean(), color=\"g\"); ax[0].set_title(\"Raw green channel\")\n",
        "ax[1].plot(t, Hf); ax[1].set_title(\"POS pulse signal (filtered)\"); ax[1].set_xlabel(\"Time (s)\")\n",
        "ax[2].plot(freqs[band] * 60, mag[band]); ax[2].axvline(bpm, ls=\"--\", c=\"r\")\n",
        "ax[2].set_title(\"Spectrum\"); ax[2].set_xlabel(\"BPM\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"/content/drive/MyDrive/rppg_results.png\", dpi=150)
        "plt.show()"
      ]
    },
